<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.keiko.community-sentiment-agent</string>

  <key>ProgramArguments</key>
  <array>
    <string>/Users/wangwenhui/miniconda3/bin/python3</string>
    <string>scripts/run_community_sentiment_agent.py</string>
    <string>--once</string>
    <string>--community-limit</string>
    <string>120</string>
    <string>--evidence-limit</string>

ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key
KEIKO_TUSHARE_TOKEN=your_tushare_token
KEIKO_FINNHUB_TOKEN=your_finnhub_key
# 雪球：登录 xueqiu.com 后从浏览器 Network 复制整段 Cookie（行情接口需要）
KEIKO_XUEQIU_COOKIE=xq_a_token=...; xq_r_token=...; device_id=...
# 可选：仅 xq_a_token 时也可（行情可能不够，评论会走浏览器）
# KEIKO_XUEQIU_TOKEN=your_xq_a_token
# 雪球评论抓取：auto=HTTP 失败后 DrissionPage 浏览器内 fetch；always=只用浏览器；never=只用 HTTP
# KEIKO_XUEQIU_BROWSER=auto
# 关注列表 agent 单轮最长运行时间（秒），默认 1200（20 分钟）；0 表示不限制
# KEIKO_SENTIMENT_CYCLE_TIMEOUT_SECONDS=1200
# 情绪刷新并行 batch 大小（每批同时处理的股票数，默认 10）
# KEIKO_SENTIMENT_SYMBOL_BATCH_SIZE=10
